# ── Server ─────────────────────────────────────────────────────────────────────
LOGIN_SERVER_PORT=3456

# ── Memory Database API (preferred write mode) ──────────────────────────────────
MEMORY_DATABASE_API_URL=http://localhost:3000
MEMORY_DATABASE_API_TOKEN=your-api-token-here

# ── PostgreSQL (fallback write mode) ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Optional: UI auth token ─────────────────────────────────────────────────────
# Require a token to access /sync and /api/* endpoints
# UI_TOKEN=your-secret-token

# ── Data directory (defaults to .data/ in cwd) ─────────────────────────────────
# DATA_DIR=/app/.data

# ── Chromium path (set automatically in Docker via Dockerfile) ─────────────────
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── Scheduler settings ──────────────────────────────────────────────────────────
SCHEDULER_CONCURRENCY=1
SCHEDULER_JOB_SPACING_MS=1000
# Overlap window (10% means 1h cadence fetches last 66 min to avoid edge misses)
SCHEDULE_SINCE_OVERLAP_PERCENT=10
